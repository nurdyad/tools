# BetterLetter HTTP Basic Auth (required)
BETTERLETTER_BASIC_AUTH_USER=
BETTERLETTER_BASIC_AUTH_PASS=

# BetterLetter account login (optional, enables auto sign-in on /sign-in page)
BETTERLETTER_USER_EMAIL=
BETTERLETTER_USER_PASSWORD=

# Auto-fetch BetterLetter 2FA code from email (optional)
# Set AUTO_2FA_FROM_EMAIL=1 to force-enable email OTP fetch, or =0 to disable.
# If unset, it auto-enables when OTP_EMAIL_IMAP_HOST/USERNAME/PASSWORD are configured.
# OTP_EMAIL_MAILBOX / OTP_EMAIL_MAILBOX_FALLBACKS accept comma-separated folder names.
AUTO_2FA_FROM_EMAIL=1
OTP_EMAIL_IMAP_HOST=imap.gmail.com
OTP_EMAIL_IMAP_PORT=993
OTP_EMAIL_IMAP_SECURE=true
OTP_EMAIL_USERNAME=
OTP_EMAIL_PASSWORD=
OTP_EMAIL_MAILBOX=BetterLetter2FA
OTP_EMAIL_MAILBOX_FALLBACKS=INBOX
OTP_EMAIL_FROM_FILTER=support@betterletter.ai
OTP_EMAIL_SUBJECT_FILTER=Your Security Code - BetterLetter,security code
OTP_EMAIL_LOOKBACK_MINUTES=20
OTP_EMAIL_TIMEOUT_SECONDS=120
OTP_EMAIL_POLL_SECONDS=4
OTP_EMAIL_CODE_REGEX=\b(\d{6})\b

# Optional override if imapflow is installed outside this project.
OTP_EMAIL_IMAPFLOW_PATH=
